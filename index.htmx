var DB=RAW.map(function(r){return{name:r[0],region:r[1],lng:r[2],lat:r[3],days:r[4],local:r[5],hl:r[6].split("|")};});
var TIPS=[
"<b>往返交通</b>：是大头。1300km 以上特价机票常比高铁便宜，本工具已自动帮你取低价。",
"<b>应届中高考生</b>：6-8 月上百家景区凭准考证免首道门票或半价，出发前查景区公众号。",
"<b>住宿</b>：青旅床位是穷游底牌，旺季提前 3-7 天订；淡季到店砍价常比线上便宜。",
"<b>门票</b>：学生证+身份证随身带，几乎所有景区半价；很多博物馆免费但要公众号预约。",
"<b>吃</b>：景区 500 米内不吃饭，往居民区走两条街；本地人排队的店就是好店。",
"<b>备用金</b>：预算留 5% 机动，总有意外（回程赶不上、临时加景点）。",
"<b>港澳</b>：从深圳/珠海口岸过关最省；办一张八达通；太平山有免费观景台；提前办港澳通行证签注。",
"<b>时段</b>：淡季出行全线便宜 30%-50%，人还少；夜车火车省一晚住宿。"
];

function dist(lng1,lat1,lng2,lat2){
 var dx=(lng1-lng2)*96,dy=(lat1-lat2)*111;
 return Math.sqrt(dx*dx+dy*dy);
}
function findCity(name){
 name=name.trim();
 if(!name)return{lng:116.4,lat:39.9,exact:false,prov:"未知"};
 for(var i=0;i<CITIES.length;i++){if(CITIES[i][0]===name)return{lng:CITIES[i][2],lat:CITIES[i][3],exact:true};}
 for(var j=0;j<CITIES.length;j++){if(CITIES[j][0].indexOf(name)>=0||name.indexOf(CITIES[j][0])>=0)return{lng:CITIES[j][2],lat:CITIES[j][3],exact:true};}
 for(var p in PROV_CENTER){if(name.indexOf(p)>=0||p.indexOf(name)>=0){var c=PROV_CENTER[p];return{lng:c[0],lat:c[1],exact:false,prov:p};}}
 return{lng:116.4,lat:39.9,exact:false,prov:"未知"};
}
// 真实行情：高铁0.51元/km，硬座/大巴0.18元/km，特价机票0.3元/km+200（单程最低300，含税口径）
// 超1300km且机票明显便宜时自动取机票（含5%抢票成本），往返双程
function transFee(km,tMul){
 var trainOne=km*0.51+40;
 var cheapOne=km*0.18+30;
 var flightOne=Math.max(300,Math.round(km*0.30+200));
 var one;
 if(tMul===1.6){one=flightOne;}
 else if(tMul===0.4||tMul===0.45){one=cheapOne;}
 else{
   one=trainOne;
   if(km>1300&&flightOne<trainOne*0.85){one=flightOne*1.05;}
 }
 return Math.max(80,Math.round(one*2));
}

var depInput=document.getElementById('dep'),cityList=document.getElementById('cityList');
depInput.addEventListener('input',function(){
 var v=this.value.trim(),html='';
 if(v){
  var hits=CITIES.filter(function(c){return c[0].indexOf(v)>=0||v.indexOf(c[0])>=0;}).slice(0,8);
  hits.forEach(function(c){html+='<div onclick="pick(\''+c[0]+'\')">'+c[0]+' <span style="color:#aaa;font-size:12px">'+c[1]+'</span></div>';});
 }
 cityList.innerHTML=html;cityList.style.display=html?'block':'none';
});
depInput.addEventListener('blur',function(){setTimeout(function(){cityList.style.display='none';},200);});
function pick(n){depInput.value=n;cityList.style.display='none';}

function recommend(){
 var depName=depInput.value.trim()||"北京";
 var region=document.getElementById('region').value;
 var tMul=+document.getElementById('transport').value;
 var iMul=+document.getElementById('identity').value;
 var days=+document.getElementById('days').value;
 var lMul=+document.getElementById('lodging').value;
 var budget=+document.getElementById('budget').value;
 var dep=findCity(depName);
 var reg=REGION_MAP[region]||"all";
 var list=DB.filter(function(d){return reg==="all"||d.region===reg;});
 list=list.map(function(d){
   // ★ 按目的地真实经纬度算距离
   var km=dist(dep.lng,dep.lat,d.lng,d.lat);
   var trans=transFee(km,tMul);
   var local=Math.round(d.local*(0.55+lMul*0.45)*(iMul===1.5?1.25:(iMul===0.85?0.92:1))*days);
   var total=trans+local+Math.round((trans+local)*0.05);
   return{d:d,km:km,trans:trans,local:local,total:total};
 });
 list.sort(function(a,b){return a.total-b.total;});

 // 预算驱动：锚点=预算内最贵的，从贵到便宜均匀取样铺开
 var show,noneMsg=false;
 var inB=list.filter(function(x){return x.total<=budget;});
 if(inB.length===0){
   show=list.slice(0,3);noneMsg=true;
 }else{
   var picks=[inB[inB.length-1]];
   var rest=inB.slice(0,-1);
   if(rest.length){
     var step=Math.max(1,Math.floor(rest.length/5));
     for(var i=rest.length-1;i>=0&&picks.length<6;i-=step){picks.push(rest[i]);}
   }
   var stretch=list.filter(function(x){return x.total>budget&&x.total<=budget*1.25;});
   if(stretch.length&&picks.length<7)picks.push(stretch[0]);
   show=picks;
 }
 // 越接近预算排越前
 show.sort(function(a,b){
   var da=Math.abs(budget-a.total),db=Math.abs(budget-b.total);
   return da-db;
 });

 var html="";
 if(show.length){
   var best=show[0];
   var within=best.total<=budget;
   html+='<div class="card"><h2>'+(within?'✅ 在预算内！':'⚠️ 稍微超一点')+'</h2><p class="sub">从 '+depName+(dep.exact?'':'（按'+(dep.prov||'附近')+'位置估算）')+' 出发，这个预算最好的去处是：</p>';
   html+='<div class="total"><div class="num">¥'+best.total.toLocaleString()+'</div><div class="meta">'+(within?'在预算内':'超预算 ¥'+(best.total-budget))+' · 日均 ¥'+Math.round(best.total/days)+' · '+days+' 天 · <b>'+best.d.name+'</b></div></div>';
   html+='<div class="breakdown">';
   html+='<div class="brow"><span class="name"><span class="dot" style="background:#1a6ee0"></span>交通往返<div class="desc">从 '+depName+' 出发约 '+Math.round(best.km)+'km × 往返</div></span><span class="amt">¥'+best.trans.toLocaleString()+'</span></div>';
   html+='<div class="brow"><span class="name"><span class="dot" style="background:#f5a623"></span>当地吃住玩<div class="desc">目的地实测标准</div></span><span class="amt">¥'+best.local.toLocaleString()+'</span></div>';
   html+='<div class="brow"><span class="name"><span class="dot" style="background:#bbb"></span>机动备用<div class="desc">总有意外</div></span><span class="amt">¥'+(best.total-best.trans-best.local).toLocaleString()+'</span></div>';
   html+='</div></div>';
   html+='<div class="card"><h2>为你挑选的目的地</h2><p class="sub">'+(noneMsg?'⚠️ 当前预算去不了'+(reg==="all"?"这些地方":region)+'，这是最接近的选择：':'预算 ¥'+budget.toLocaleString()+' · '+(reg==="all"?"全国":region)+' · 调整预算会解锁不同目的地')+'</p>';
   show.forEach(function(x){
     var ok=x.total<=budget;
     html+='<div class="dest"><h3>'+x.d.name+'</h3><span class="tag '+(ok?'ok':'no')+'">'+(ok?'✅ ¥'+x.total.toLocaleString()+' 在预算内':'⚠️ ¥'+x.total.toLocaleString()+' 超预算')+'</span>';
     html+='<p class="sub2">'+x.d.region+' · '+x.d.hl.join(' / ')+'</p>';
     html+='<div class="badges"><span class="badge">🚄 从'+depName+'往返约 <b>¥'+x.trans+'</b>（'+Math.round(x.km)+'km）</span><span class="badge">🧾 当地约 <b>¥'+x.local+'</b></span><span class="badge">📅 建议 '+x.d.days+' 天</span></div>';
     html+='<button class="plan-btn" onclick="this.nextElementSibling.classList.toggle(\'show\')">查看行程建议 ▼</button><div class="plan">'+makePlan(x.d,days)+'</div></div>';
   });
   html+='</div>';
 }else{
   html='<div class="card"><h2>😕 没找到匹配</h2><p class="sub">试试放宽地区或提高预算。</p></div>';
 }
 document.getElementById('result').innerHTML=html;
 document.getElementById('tips').innerHTML=TIPS.map(function(t){return '<div class="tip">› '+t+'</div>';}).join('');
}
function makePlan(d,days){
 var h='',n=Math.min(days,d.days+2);
 for(var i=0;i<n;i++){
   h+='<h4>Day '+(i+1)+'</h4><ul><li>'+d.hl[i%d.hl.length]+'</li><li>'+d.hl[(i+1)%d.hl.length]+'</li><li>晚上：当地夜市/老街逛吃，住青旅</li></ul>';
 }
 return h;
}
</script>
</body>
</html>
